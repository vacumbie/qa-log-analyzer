# Python cache — never commit these
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/
dist/
.eggs/

# Virtual environment
venv/

# Node
ui/node_modules/
ui/dist/
ui/.vite/

# Env files
.env
.env.local
*.env

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp

# Real log files — don't commit these
logs/
*.log

# Test fixtures are intentionally committed regardless of extension
!tests/fixtures/
!tests/fixtures/*